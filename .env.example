# Copiar a backend/.env para desarrollo local (backend/.env NO se sube a GitHub).
# Generar una clave:  python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Sin DATABASE_URL se usa SQLite local (backend/db.sqlite3).
# DATABASE_URL=postgres://usuario:clave@localhost:5432/soporte
# DJANGO_CSRF_TRUSTED_ORIGINS=https://soporte.maiproject.cl
# SENTRY_DSN=   (clave del proyecto en GlitchTip, opcional)
